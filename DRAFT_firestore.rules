rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
          && data.email is string && data.email.size() <= 256
          && (data.get('displayName', '') == null || (data.displayName is string && data.displayName.size() <= 100))
          && (data.get('photoURL', '') == null || (data.photoURL is string && data.photoURL.size() <= 1000))
          && (data.get('organizationId', '') == null || (data.organizationId is string && data.organizationId.size() <= 100))
          && data.products is list
          && data.products.size() <= 20;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // READ: Only the owner can read their profile
      allow get: if isOwner(userId);
      // Admin might list, but client cannot blanket search users
      allow list: if false;

      // CREATE: Initial profile setup
      allow create: if isOwner(userId) 
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time
        // Security constraint: Frontend can only create with EMPTY products
        && incoming().products.size() == 0;

      // UPDATE: Tiered Action Logic
      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          // Action: Profile Update (Frontend)
          // Frontend can update displayName, photoURL, organizationId, lastLoginAt
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'organizationId', 'lastLoginAt'])
          && incoming().lastLoginAt == request.time
          && incoming().products == existing().products // Immutable via frontend
        );

      allow delete: if false; // Deletion only via support/admin
    }

    // Organizations and other collections should follow similar Master Gate patterns
    match /organizations/{orgId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        exists(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid))
      );
      
      // Writes typically handled by Admin SDK or strict Tiered updates
      allow write: if false; 

      match /memberships/{memberId} {
        allow read: if isSignedIn() && (isOwner(memberId) || isOwner(get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId));
      }
    }
  }
}
