{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Centralized user profile for MillionsNest ecosystem.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "products": { "type": "array", "description": "Managed by backend. e.g. ['musicscale']" },
        "organizationId": { "type": "string", "description": "Currently active organization workspace ID." },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Multi-tenant entity representing a church or band.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "subscriptionStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
    "organization_members": {
      "title": "Organization Membership",
      "description": "Global link between users and organizations with roles.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "organizationId": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "member"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "organizationId", "role"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Primary user documents."
    },
    "organizations/{orgId}": {
      "schema": "Organization",
      "description": "Organization details."
    },
    "organization_members/{memberId}": {
      "schema": "organization_members",
      "description": "Global membership records."
    }
  }
}
