rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    // Deny all by default to ensure no accidental leaks.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validates document ID safety to prevent resource poisoning.
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    // Strict schema check for the User entity.
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
          && data.email is string && data.email.size() <= 256
          && (data.get('displayName', '') == null || (data.displayName is string && data.displayName.size() <= 100))
          && (data.get('name', '') == null || (data.name is string && data.name.size() <= 100))
          && (data.get('photoURL', '') == null || (data.photoURL is string && data.photoURL.size() <= 1000))
          && (data.get('organizationId', '') == null || (data.organizationId is string && data.organizationId.size() <= 100))
          && data.products is list
          && data.products.size() <= 20;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().products == existing().products; // Users cannot modify their own products list
    }

    // --- Organizations & Tenant Logic ---
    
    match /organizations/{orgId} {
      // Organization access is derived from ownership OR existence in global organization_members.
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        // Lookup in global organization_members collection. 
        exists(/databases/$(database)/documents/organization_members/$(request.auth.uid + "_" + orgId))
      );
      
      // Critical configurations managed by Backend Admin Sync only.
      allow write: if false;
    }

    match /organization_members/{memberId} {
      // Users can only see their own memberships, or owners can see their org members.
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)).data.ownerUid == request.auth.uid
      );
      
      // Membership creation/removal is a privileged backend action (onboarding/billing flow).
      allow write: if false;
    }

    match /subscriptions/{subId} {
      // Document ID is strictly the UID representing the user's subscription state.
      allow get: if isOwner(subId);
      allow list: if false;
      // Modified ONLY via Stripe Webhook + Firebase Admin SDK.
      allow write: if false;
    }
  }
}
