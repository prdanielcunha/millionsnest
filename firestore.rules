    function journeyValidFollowupOutcomePair(outcomeCode, nextActionCode) {
      return
        (outcomeCode == 'responded' && nextActionCode == 'none') ||
        (outcomeCode == 'prayer_requested' && nextActionCode == 'care_prayer') ||
        (outcomeCode == 'group_interest' && nextActionCode == 'group_entry') ||
        (outcomeCode == 'declined_contact' && nextActionCode == 'none') ||
        (outcomeCode == 'invalid_contact' && nextActionCode == 'data_correction') ||
        (outcomeCode == 'no_response' && nextActionCode == 'manual_review');
    }

    function journeyValidFollowupCareResolution(outcomeCode, resolutionCode) {
      return
        (outcomeCode in ['responded', 'prayer_requested', 'group_interest'] && resolutionCode == 'contact_completed') ||
        (outcomeCode == 'declined_contact' && resolutionCode == 'declined_contact') ||
        (outcomeCode == 'invalid_contact' && resolutionCode == 'invalid_contact') ||
        (outcomeCode == 'no_response' && resolutionCode == 'closed_no_response');
    }

    function journeyValidFollowupComplete(orgId) {
      let careRequestId = resource.data.get('careRequestId', '');
      let carePath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/careRequests/$(careRequestId);
      let careData = getAfter(carePath).data;
      let outcomeCode = request.resource.data.get('outcomeCode', '');
      let nextActionCode = request.resource.data.get('nextActionCode', '');
      return resource.data.get('status', '') == 'pending' &&
        resource.data.get('ownerRef', '') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedAt', 'completedBy', 'outcomeCode', 'nextActionCode'
        ]) &&
        request.resource.data.get('status', '') == 'completed' &&
        request.resource.data.get('completedAt', null) == request.time &&
        request.resource.data.get('completedBy', '') == request.auth.uid &&
        journeyValidFollowupOutcomePair(outcomeCode, nextActionCode) &&
        careData.get('status', '') == 'resolved' &&
        careData.get('resolvedAt', null) == request.time &&
        careData.get('resolvedBy', '') == request.auth.uid &&
        journeyValidFollowupCareResolution(outcomeCode, careData.get('resolutionCode', ''));
    }

    function journeyValidCareResolvedFactDocument(orgId, factId) {
      let payload = request.resource.data.get('payload', {});
      let careRequestId = payload.get('careRequestId', '');
      let personId = payload.get('personId', '');
      let carePath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/careRequests/$(careRequestId);
      let careData = getAfter(carePath).data;
      return request.resource.data.get('organizationId', '') == orgId &&
        request.resource.data.get('eventId', '') == factId &&
        request.resource.data.get('eventType', '') == 'CARE_RESOLVED' &&
        request.resource.data.get('actorId', '') == request.auth.uid &&
        request.resource.data.get('sourceApp', '') == 'nestjourney' &&
        request.resource.data.get('version', 0) == 1 &&
        request.resource.data.get('recordedAt', null) == request.time &&
        request.resource.data.get('occurredAt', null) == request.time &&
        request.resource.data.get('sensitivity', '') == 'confidential' &&
        factId == 'care-resolved-' + careRequestId &&
        careData.get('status', '') == 'resolved' &&
        careData.get('resolvedAt', null) == request.time &&
        careData.get('resolvedBy', '') == request.auth.uid &&
        careData.get('personId', '') == personId &&
        careData.get('careType', '') == payload.get('careType', '') &&
        careData.get('resolutionCode', '') == payload.get('resolutionCode', '') &&
        request.resource.data.get('subjectRef', '') == 'person:' + personId &&
        request.resource.data.get('evidenceRef', '') == 'careRequest:' + careRequestId &&
        request.resource.data.get('scope', '') == 'congregation:' + careData.get('congregationId', '');
    }

    function journeyValidFollowupCanonicalFact(orgId, factId, eventType, payload) {
      let followupId = payload.get('followupId', '');
      let careRequestId = payload.get('careRequestId', '');
      let personId = payload.get('personId', '');
      let followupPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/followups/$(followupId);
      let followupData = getAfter(followupPath).data;
      return followupData.get('personId', '') == personId &&
        followupData.get('careRequestId', '') == careRequestId &&
        request.resource.data.get('subjectRef', '') == 'person:' + personId &&
        request.resource.data.get('evidenceRef', '') == 'followup:' + followupId &&
        request.resource.data.get('scope', '') == 'congregation:' + followupData.get('congregationId', '') &&
        (
          (
            eventType == 'FOLLOWUP_CREATED' &&
            factId == 'followup-created-' + followupId &&
            followupData.get('status', '') == 'pending' &&
            followupData.get('createdAt', null) == request.time &&
            followupData.get('createdBy', '') == request.auth.uid
          ) ||
          (
            eventType == 'FOLLOWUP_COMPLETED' &&
            factId == 'followup-completed-' + followupId &&
            followupData.get('status', '') == 'completed' &&
            followupData.get('completedAt', null) == request.time &&
            followupData.get('completedBy', '') == request.auth.uid &&
            followupData.get('outcomeCode', '') == payload.get('outcomeCode', '') &&
            followupData.get('nextActionCode', '') == payload.get('nextActionCode', '')
          )
        );
    }

    function journeyValidFollowupFactDocument(orgId, factId) {
      let eventType = request.resource.data.get('eventType', '');
      let payload = request.resource.data.get('payload', {});
      return request.resource.data.get('organizationId', '') == orgId &&
        request.resource.data.get('eventId', '') == factId &&
        request.resource.data.get('actorId', '') == request.auth.uid &&
        request.resource.data.get('sourceApp', '') == 'nestjourney' &&
        request.resource.data.get('version', 0) == 1 &&
        request.resource.data.get('recordedAt', null) == request.time &&
        request.resource.data.get('occurredAt', null) == request.time &&
        request.resource.data.get('subjectRef', '') is string &&
        request.resource.data.get('scope', '') is string &&
        request.resource.data.get('evidenceRef', '') is string &&
        request.resource.data.get('evidenceRef', '').size() > 0 &&
        request.resource.data.get('sensitivity', '') == 'confidential' &&
        eventType in ['FOLLOWUP_CREATED', 'FOLLOWUP_COMPLETED'] &&
        journeyValidFollowupCanonicalFact(orgId, factId, eventType, payload);
    }

    function journeyValidImplementationKey(key) {
      return key is string &&
        key.matches('^(prep[.][1-7]|week[.]1[.](practice|teach[.][1-4])|week[.]2[.](practice|teach[.][1-5])|week[.]3[.](practice|teach[.][1-4])|week[.]4[.](practice|teach[.][1-5])|week[.]5[.](practice|teach[.][1-5])|week[.]6[.](practice|teach[.][1-4])|week[.]7[.](practice|teach[.][1-5]))$');
    }

    function journeyValidImplementationCycleCreate(orgId) {
      return journeyTenantCreate(orgId) &&
        request.resource.data.get('congregationId', '') is string &&
        request.resource.data.get('playbookId', '') == 'raiz_e_mesa_2026' &&
        request.resource.data.get('status', '') == 'active' &&
        request.resource.data.get('startedAt', null) == request.time &&
        request.resource.data.get('createdAt', null) == request.time &&
        request.resource.data.get('createdBy', '') == request.auth.uid;
