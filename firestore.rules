rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    // ==========================================
    // FUNÇÕES AUXILIARES E GLOBAIS
    // ==========================================

    function isAuthenticated() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function checkMemberExists(orgId) {
      return (orgId is string) && (
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId)) ||
        exists(/databases/$(database)/documents/organization_members/$(orgId + '_' + request.auth.uid))
      );
    }

    function isOrgActive(orgId) {
      let subDoc = get(/databases/$(database)/documents/subscriptions/$(orgId));
      let orgDoc = get(/databases/$(database)/documents/organizations/$(orgId));
      
      let subData = subDoc != null ? subDoc.data : null;
      let orgData = orgDoc != null ? orgDoc.data : null;
      
      let subActive = subData != null && 'status' in subData && (subData.status == 'active' || subData.status == 'trialing');
      
      let appActive = orgData != null && 'apps' in orgData && 'musicscale' in orgData.apps && 'status' in orgData.apps.musicscale && (orgData.apps.musicscale.status == 'active' || orgData.apps.musicscale.status == 'trialing');

      return subActive || appActive || isSystemAdmin();
    }

    function checkOrgAccess(orgId) {
      let orgDoc = get(/databases/$(database)/documents/organizations/$(orgId));
      let isOwner = orgDoc != null && (
        ('ownerUid' in orgDoc.data && orgDoc.data.ownerUid == request.auth.uid) || 
        ('ownerId' in orgDoc.data && orgDoc.data.ownerId == request.auth.uid) || 
        ('owner_user_id' in orgDoc.data && orgDoc.data.owner_user_id == request.auth.uid) ||
        ('ownerUserId' in orgDoc.data && orgDoc.data.ownerUserId == request.auth.uid)
      );
      
      return (checkMemberExists(orgId) || isOwner || isSystemAdmin());
    }

    function hasOrgContext(data) {
      return ('organizationId' in data) && checkOrgAccess(data.organizationId);
    }
    
    function getMemberRole(orgId) {
       let memberData = getMemberPermissions(orgId);
       return memberData != null && 'role' in memberData ? memberData.role : null;
    }

    function isOrgAdmin(orgId) {
      let role = getMemberRole(orgId);
      return role == 'admin' || role == 'owner' || isSystemAdmin();
    }

    function isOrgOwner(orgId) {
      let role = getMemberRole(orgId);
      return role == 'owner' || isSystemAdmin();
    }

    function getMemberPermissions(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
         ? get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data
         : (exists(/databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId))
            ? get(/databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId)).data
            : (exists(/databases/$(database)/documents/organization_members/$(orgId + '_' + request.auth.uid))
               ? get(/databases/$(database)/documents/organization_members/$(orgId + '_' + request.auth.uid)).data
               : null));
    }

    function hasPermission(orgId, permission) {
      let memberData = getMemberPermissions(orgId);
      let role = memberData != null && 'role' in memberData ? memberData.role : null;
      let hasExplicitPerm = memberData != null && 'permissions' in memberData && permission in memberData.permissions && memberData.permissions[permission] == true;
      
      return isSystemAdmin() || role == 'owner' || role == 'admin' || hasExplicitPerm;
    }
    
    function isSystemAdmin() {
      let userDoc = isAuthenticated() ? get(/databases/$(database)/documents/users/$(request.auth.uid)) : null;
      return userDoc != null && 'systemRole' in userDoc.data && (userDoc.data.systemRole == 'ceo' || userDoc.data.systemRole == 'global_admin' || userDoc.data.systemRole == 'ecosystem_owner' || userDoc.data.systemRole == 'founder');
    }

    function isRaizEMesaActive(orgId) {
      let orgData = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      return isSystemAdmin() || (
        orgData != null &&
        orgData.get('apps', {}).get('raiz_e_mesa', {}).get('status', '') in ['active', 'trialing']
      );
    }

    function raizMemberRole(orgId) {
      let member = getMemberPermissions(orgId);
      let appAccess = member != null ? member.get('appAccess', {}).get('raiz_e_mesa', {}) : {};
      let roles = appAccess.get('roles', []);
      return roles is list && roles.size() > 0
        ? roles[0]
        : appAccess.get('role', member != null ? member.get('organizationRole', member.get('role', '')) : '');
    }

    function raizHasRole(orgId, roles) {
      return isSystemAdmin() || (checkOrgAccess(orgId) && raizMemberRole(orgId) in roles);
    }

    function raizCanAccessCongregation(orgId, congregationId) {
      let member = getMemberPermissions(orgId);
      return isRaizEMesaActive(orgId) && checkOrgAccess(orgId) && (
        isOrgAdmin(orgId) ||
        raizHasRole(orgId, ['pastor', 'data_admin']) ||
        (member != null && congregationId in member.get('congregationIds', []))
      );
    }

    // ==========================================
    // 1. DADOS DOS USUÁRIOS
    // ==========================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isSystemAdmin() || ('organizationId' in resource.data && checkOrgAccess(resource.data.organizationId)));
      allow create: if isAuthenticated() && isSystemAdmin();
      allow update: if isAuthenticated() && (
        isSystemAdmin() ||
        (
          (isOwner(userId) || (resource != null && 'organizationId' in resource.data && isOrgAdmin(resource.data.organizationId))) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId', 'activeOrganizationId', 'primaryOrganizationId', 'defaultOrganizationId', 'lastOrganizationId', 'organizations', 'organizationIds', 'memberships', 'organizationRole', 'systemRole', 'globalRole', 'capabilities', 'appsAccess', 'products', 'lifetimeAccess'])
        )
      );
      allow delete: if isAuthenticated() && (isSystemAdmin() || (resource != null && 'organizationId' in resource.data && isOrgAdmin(resource.data.organizationId) && checkOrgAccess(resource.data.organizationId)));
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // 2. DADOS DA ORGANIZAÇÃO (CORE)
    // ==========================================

    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin() ||
        (resource != null && resource.data.get('ownerUid', '') == request.auth.uid) ||
        (resource != null && resource.data.get('ownerId', '') == request.auth.uid) ||
        (resource != null && resource.data.get('owner_user_id', '') == request.auth.uid) ||
        (resource != null && resource.data.get('ownerUserId', '') == request.auth.uid) ||
        checkMemberExists(orgId)
      );
      allow create: if isAuthenticated() && isSystemAdmin();
      allow update: if isAuthenticated() && (
        isSystemAdmin() ||
        resource.data.get('ownerUid', '') == request.auth.uid || 
        resource.data.get('ownerId', '') == request.auth.uid || 
        resource.data.get('owner_user_id', '') == request.auth.uid || 
        (checkMemberExists(orgId) && isOrgOwner(orgId))
      );
      allow delete: if false; 

      // ---------------------------------------------------------------------------------
      // MULTI-TENANT ISOLATION (NOVA ESTRUTURA)
      // ---------------------------------------------------------------------------------
      
      match /monthly_usage/{monthStr} {
        allow read: if isAuthenticated() && checkOrgAccess(orgId);
        allow write: if false;
      }

      match /members/{uid} {
        allow read: if isAuthenticated() && (
          uid == request.auth.uid || checkOrgAccess(orgId) || isSystemAdmin()
        );
        allow list: if isAuthenticated() && (checkOrgAccess(orgId) || isSystemAdmin());
        allow create: if isAuthenticated() && (isOrgAdmin(orgId) || isSystemAdmin());
        allow update, delete: if isAuthenticated() && (
          isOrgAdmin(orgId) || isSystemAdmin()
        );
      }

      match /invites/{inviteId} {
        allow read, list: if isAuthenticated() && (
          checkOrgAccess(orgId) || isSystemAdmin()
        );
        allow create, update, delete: if isAuthenticated() && (isOrgAdmin(orgId) || isSystemAdmin());
      }

      match /join_requests/{requestId} {
        allow read, list: if isAuthenticated() && (
          isSystemAdmin() ||
          (
            exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', '') == 'active' &&
            (
              get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', '') == 'owner' ||
              get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', '') == 'admin' ||
              get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('organizationRole', '') == 'owner' ||
              get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('organizationRole', '') == 'admin'
            )
          )
        );
        allow create, update, delete: if false;
      }

      match /audit_logs/{document=**} {
        allow read: if isAuthenticated() && checkOrgAccess(orgId);
        allow write: if isAuthenticated() && checkOrgAccess(orgId);
      }
      match /timeline/{document=**} {
        allow read: if isAuthenticated() && checkOrgAccess(orgId);
        allow write: if isAuthenticated() && checkOrgAccess(orgId);
      }

      match /products/raiz_e_mesa {
        allow read: if isAuthenticated() && checkOrgAccess(orgId) && isRaizEMesaActive(orgId);
        allow write: if false;

        match /settings/{settingId} {
          allow read: if isAuthenticated() && checkOrgAccess(orgId) && isRaizEMesaActive(orgId);
          allow create, update: if isRaizEMesaActive(orgId) && (isOrgAdmin(orgId) || raizHasRole(orgId, ['pastor', 'data_admin']))
            && request.resource.data.get('organizationId', '') == orgId;
          allow delete: if false;
        }
        match /implementation/{progressId} {
          allow read: if isAuthenticated() && checkOrgAccess(orgId) && isRaizEMesaActive(orgId);
          allow create, update: if isRaizEMesaActive(orgId)
            && raizHasRole(orgId, ['owner', 'admin', 'pastor', 'coordinator'])
            && request.resource.data.get('organizationId', '') == orgId;
          allow delete: if false;
        }
        match /congregations/{congregationId} {
          allow read: if raizCanAccessCongregation(orgId, congregationId) || isOrgAdmin(orgId);
          allow create, update: if isRaizEMesaActive(orgId) && (isOrgAdmin(orgId) || raizHasRole(orgId, ['pastor', 'data_admin']))
            && request.resource.data.get('organizationId', '') == orgId;
          allow delete: if false;
        }
        match /people/{personId} {
          allow read: if raizCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if request.resource.data.get('organizationId', '') == orgId
            && raizCanAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
            && raizHasRole(orgId, ['owner', 'admin', 'pastor', 'coordinator', 'care', 'data_admin']);
          allow update: if resource.data.get('organizationId', '') == orgId
            && request.resource.data.get('organizationId', '') == orgId
            && request.resource.data.get('congregationId', '') == resource.data.get('congregationId', '')
            && raizCanAccessCongregation(orgId, resource.data.get('congregationId', ''))
            && raizHasRole(orgId, ['owner', 'admin', 'pastor', 'coordinator', 'care', 'data_admin']);
          allow delete: if false;
        }
        match /presence/{presenceId} {
          allow read: if raizCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create, update: if request.resource.data.get('organizationId', '') == orgId
            && raizCanAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
            && raizHasRole(orgId, ['owner', 'admin', 'pastor', 'coordinator']);
          allow delete: if false;
        }
        match /groups/{groupId} {
          allow read: if raizCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create, update: if request.resource.data.get('organizationId', '') == orgId
            && raizCanAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
            && raizHasRole(orgId, ['owner', 'admin', 'pastor', 'group_leader']);
          allow delete: if false;
        }
        match /groupMeetings/{meetingId} {
          allow read: if raizCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create, update: if request.resource.data.get('organizationId', '') == orgId
            && raizCanAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
            && raizHasRole(orgId, ['owner', 'admin', 'pastor', 'group_leader']);
          allow delete: if false;
        }
        match /joinRequests/{requestId} {
          allow read: if raizCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if request.resource.data.get('organizationId', '') == orgId
            && raizCanAccessCongregation(orgId, request.resource.data.get('congregationId', ''));
          allow update: if resource.data.get('organizationId', '') == orgId
            && request.resource.data.get('organizationId', '') == orgId
            && raizHasRole(orgId, ['owner', 'admin', 'pastor', 'group_leader']);
          allow delete: if false;
        }
        match /discipleships/{discipleshipId} {
          allow read: if raizCanAccessCongregation(orgId, resource.data.get('congregationId', ''))
            && (raizHasRole(orgId, ['owner', 'admin', 'pastor']) || resource.data.get('disciplerId', '') == request.auth.uid);
          allow create, update: if request.resource.data.get('organizationId', '') == orgId
            && raizCanAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
            && (raizHasRole(orgId, ['owner', 'admin', 'pastor']) || request.resource.data.get('disciplerId', '') == request.auth.uid);
          allow delete: if false;
        }
        match /teamAssignments/{assignmentId} {
          allow read: if isOrgAdmin(orgId) || raizHasRole(orgId, ['pastor', 'data_admin']);
          allow create, update: if isOrgAdmin(orgId) && request.resource.data.get('organizationId', '') == orgId;
          allow delete: if false;
        }
        match /pastoral/{pastoralId} {
          allow read, create, update: if request.resource.data.get('organizationId', resource.data.get('organizationId', '')) == orgId
            && raizHasRole(orgId, ['owner', 'admin', 'pastor']);
          allow delete: if false;
        }
        match /audit/{auditId} {
          allow read: if isOrgAdmin(orgId) || raizHasRole(orgId, ['pastor', 'data_admin']);
          allow create: if request.resource.data.get('organizationId', '') == orgId
            && request.resource.data.get('actorId', '') == request.auth.uid
            && request.resource.data.get('createdAt', null) == request.time
            && isAuthenticated() && checkOrgAccess(orgId) && isRaizEMesaActive(orgId);
          allow update, delete: if false;
        }
        match /retentionRequests/{requestId} {
          allow read: if isOrgAdmin(orgId) || raizHasRole(orgId, ['data_admin']);
          allow create: if request.resource.data.get('organizationId', '') == orgId
            && request.resource.data.get('requestedBy', '') == request.auth.uid
            && isAuthenticated() && checkOrgAccess(orgId) && isRaizEMesaActive(orgId);
          allow update: if resource.data.get('organizationId', '') == orgId
            && request.resource.data.get('organizationId', '') == orgId
            && (isOrgAdmin(orgId) || raizHasRole(orgId, ['data_admin']))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', '_updatedAt', '_updatedBy']);
          allow delete: if false;
        }
        match /{document=**} { allow read, write: if false; }
      }

      match /products/{productId}/{document=**} {
        allow read, create, update, delete: if productId != 'raiz_e_mesa'
          && isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
      }

      match /{app}/{document=**} {
        allow read: if app != 'join_requests' && app != 'products' && isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
        allow create: if app != 'join_requests' && app != 'products' && isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
        allow update, delete: if app != 'join_requests' && app != 'products' && isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
      }
    }

    match /organization_members/{id} {
      allow read: if isAuthenticated() && (
        id.split('_')[0] == request.auth.uid ||
        id.split('_')[1] == request.auth.uid ||
        checkOrgAccess(id.split('_')[1]) ||
        checkOrgAccess(id.split('_')[0])
      );
      allow list: if isAuthenticated() && isSystemAdmin();
      allow create: if isAuthenticated() && (isOrgAdmin(request.resource.data.get('organizationId', '')) || isSystemAdmin());
      allow update: if isAuthenticated() && (
        isSystemAdmin() || 
        (checkOrgAccess(resource.data.get('organizationId', '')) && isOrgAdmin(resource.data.get('organizationId', '')))
      );
      allow delete: if isAuthenticated() && (
        isSystemAdmin() || 
        (checkOrgAccess(resource.data.get('organizationId', '')) && isOrgAdmin(resource.data.get('organizationId', '')))
      );
    }

    // ==========================================
    // 3. ASSINATURAS E CONVITES
    // ==========================================
    
    match /subscriptions/{userId} {
      allow read, list: if isAuthenticated() && (
        checkOrgAccess(userId) || 
        isSystemAdmin() ||
        (resource != null && 'organizationId' in resource.data && checkOrgAccess(resource.data.organizationId)) ||
        (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
        (resource == null)
      );
      allow write: if false; 
    }

    match /stripe_events_audit/{eventId} {
      allow read, write: if false;
    }

    match /invitations/{inviteId} {
      allow read: if isAuthenticated() && ('organizationId' in resource.data && checkOrgAccess(resource.data.organizationId));
       allow write: if isAuthenticated() && 
                    checkMemberExists(request.resource.data.get('organizationId', '')) &&
                    isOrgAdmin(request.resource.data.get('organizationId', '')) &&
                    isOrgActive(request.resource.data.get('organizationId', ''));
    }
    
    match /invites/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organization_id', ''));
      allow write: if false; 
    }

    // ==========================================
    // 4. MÓDULOS DE NEGÓCIO (APP MILLIONSNEST E OUTROS)
    // ==========================================
    
    match /repertoire/{songId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && checkOrgAccess(request.resource.data.get('organizationId', '')) && isOrgActive(request.resource.data.get('organizationId', ''));
      allow update: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /schedules/{scheduleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && checkOrgAccess(request.resource.data.get('organizationId', '')) && isOrgActive(request.resource.data.get('organizationId', ''));
      allow update: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /feedbacks/{feedbackId} {
       allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
       allow create: if isAuthenticated() && (request.resource.data.get('organizationId', '') == 'none' || (checkOrgAccess(request.resource.data.get('organizationId', '')) && isOrgActive(request.resource.data.get('organizationId', ''))));
       allow update, delete: if false;
    }

    // ==========================================
    // 5. MÓDULOS MUSIC SCALE (ACERVO MUSIC SCALE)
    // ==========================================

    match /songs/{songId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /scales/{scaleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageScales') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /bandScales/{scaleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageScales') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /fixedBandScales/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageScales') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /liveSessions/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageScales') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /roles/{roleId} {
      allow get: if isAuthenticated() && 'organizationId' in resource.data && checkOrgAccess(resource.data.get('organizationId', ''));
      allow list: if isAuthenticated() && 'organizationId' in resource.data && (checkOrgAccess(resource.data.get('organizationId', '')) || checkMemberExists(resource.data.get('organizationId', '')) || resource.data.get('organizationId', '') == request.auth.uid);
      allow create: if isAuthenticated() && isOrgAdmin(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && isOrgAdmin(resource.data.get('organizationId', '')) && checkOrgAccess(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && isOrgAdmin(resource.data.get('organizationId', '')) && checkOrgAccess(resource.data.get('organizationId', ''));
    }

    match /locations/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /eventTypes/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /eventNames/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /tags/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /instruments/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /suggestions/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasOrgContext(incoming()) && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    // ==========================================
    // 6. RECURSOS GLOBAIS
    // ==========================================

    function hasGlobalLibraryFeature() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let orgId = userDoc != null ? userDoc.data.get('organizationId', null) : null;
      let subDoc = orgId != null ? get(/databases/$(database)/documents/subscriptions/$(orgId)) : null;
      return subDoc != null && subDoc.data.get('features', {}).get('globalLibrary', false) == true;
    }

    match /globalSongs/{id} {
      allow read: if isAuthenticated() && (isSystemAdmin() || hasGlobalLibraryFeature());
      allow write: if isAuthenticated() && isSystemAdmin();
    }

    match /songSubmissions/{id} {
      allow read: if isAuthenticated() && (isSystemAdmin() || resource.data.get('submittedBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && hasOrgContext(incoming());
      allow update, delete: if isSystemAdmin();
    }
    
    // ==========================================
    // 7. ECOSYSTEM INFRASTRUCTURE COLLECTIONS
    // ==========================================

    match /analytics_events/{eventId} {
      allow create: if true;
      allow read: if isSystemAdmin();
      allow update, delete: if false;
    }

    match /system_audit_logs/{logId} {
      allow create: if isAuthenticated(); 
      allow read: if isSystemAdmin();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow create: if isAuthenticated(); 
      allow read: if isSystemAdmin();
      allow update, delete: if isSystemAdmin(); 
    }

    match /audits/{logId} {
      allow create: if isAuthenticated(); 
      allow read: if isSystemAdmin();
      allow update, delete: if isSystemAdmin(); 
    }

    match /apps/{appId} {
      allow read: if isAuthenticated(); 
      allow write: if isSystemAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }

    match /ecosystemHandoffs/{handoffId} {
      allow read, write: if false;
    }
  }
}
