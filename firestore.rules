          resource.data.get('organizationId', '') &&
        request.resource.data.get('congregationId', '') ==
          resource.data.get('congregationId', '') &&
        request.resource.data.get('groupId', '') == groupId &&
        request.resource.data.get('personId', '') == personId &&
        request.resource.data.get('personName', '') ==
          resource.data.get('personName', '') &&
        request.resource.data.get('requestedAt', null) ==
          resource.data.get('requestedAt', null) &&
        request.resource.data.get('requestedBy', '') ==
          resource.data.get('requestedBy', '') &&
        resource.data.get('status', '') == 'pending' &&
        nextStatus in ['accepted', 'declined'] &&
        request.resource.data.get('resolvedAt', null) == request.time &&
        request.resource.data.get('resolvedBy', '') == request.auth.uid &&
        journeyCanManageGroupRoster(orgId, groupId) &&
        (
          nextStatus == 'declined' ||
          (
            existsAfter(membershipPath) &&
            getAfter(membershipPath).data.get('status', '') == 'active'
          )
        );
    }

    function journeyValidGroupMembershipCreate(orgId, membershipId) {
      let groupId = request.resource.data.get('groupId', '');
      let personId = request.resource.data.get('personId', '');
      let groupPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/groups/$(groupId);
      let personPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/people/$(personId);
      return request.resource.data.keys().hasOnly([
          'organizationId', 'congregationId', 'groupId', 'personId', 'personName',
          'status', 'joinedAt', 'joinedBy', 'leftAt', 'leftBy'
        ]) &&
        request.resource.data.get('organizationId', '') == orgId &&
        groupId is string &&
        groupId.size() > 0 &&
        personId is string &&
        personId.size() > 0 &&
        membershipId == groupId + '__' + personId &&
        request.resource.data.get('status', '') == 'active' &&
        request.resource.data.get('joinedAt', null) == request.time &&
        request.resource.data.get('joinedBy', '') == request.auth.uid &&
        request.resource.data.get('leftAt', null) == null &&
        request.resource.data.get('leftBy', '') == '' &&
        journeyCanManageGroupRoster(orgId, groupId) &&
        exists(groupPath) &&
        exists(personPath) &&
        get(groupPath).data.get('congregationId', '') ==
          request.resource.data.get('congregationId', '') &&
        get(personPath).data.get('congregationId', '') ==
          request.resource.data.get('congregationId', '');
    }

    function journeyValidGroupMembershipUpdate(orgId) {
      let groupId = resource.data.get('groupId', '');
      let nextStatus = request.resource.data.get('status', '');
      let previousStatus = resource.data.get('status', '');
      return request.resource.data.get('organizationId', '') == orgId &&
        request.resource.data.get('organizationId', '') ==
          resource.data.get('organizationId', '') &&
        request.resource.data.get('congregationId', '') ==
          resource.data.get('congregationId', '') &&
        request.resource.data.get('groupId', '') == groupId &&
        request.resource.data.get('personId', '') ==
          resource.data.get('personId', '') &&
        request.resource.data.get('personName', '') ==
          resource.data.get('personName', '') &&
        journeyCanManageGroupRoster(orgId, groupId) &&
        (
          (
            previousStatus == 'active' &&
            nextStatus == 'left' &&
            request.resource.data.get('joinedAt', null) ==
              resource.data.get('joinedAt', null) &&
            request.resource.data.get('joinedBy', '') ==
              resource.data.get('joinedBy', '') &&
            request.resource.data.get('leftAt', null) == request.time &&
            request.resource.data.get('leftBy', '') == request.auth.uid
          ) ||
          (
            previousStatus == 'left' &&
            nextStatus == 'active' &&
            request.resource.data.get('joinedAt', null) == request.time &&
            request.resource.data.get('joinedBy', '') == request.auth.uid &&
            request.resource.data.get('leftAt', null) == null &&
            request.resource.data.get('leftBy', '') == ''
          )
        );
    }

    function journeyValidGroupMeetingCreate(orgId) {
      let groupId = request.resource.data.get('groupId', '');
      let congregationId = request.resource.data.get('congregationId', '');
      let groupPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/groups/$(groupId);
      return request.resource.data.keys().hasOnly([
          'organizationId', 'congregationId', 'groupId', 'status',
          'startedAt', 'createdBy', 'endedAt', 'closedBy'
        ]) &&
        journeyTenantCreate(orgId) &&
        groupId is string &&
        groupId.size() > 0 &&
        congregationId is string &&
        congregationId.size() > 0 &&
        request.resource.data.get('status', '') == 'open' &&
        request.resource.data.get('startedAt', null) == request.time &&
        request.resource.data.get('createdBy', '') == request.auth.uid &&
        request.resource.data.get('endedAt', null) == null &&
        request.resource.data.get('closedBy', '') == '' &&
        journeyCanManageGroupRoster(orgId, groupId) &&
        exists(groupPath) &&
        get(groupPath).data.get('congregationId', '') == congregationId;
    }

    function journeyValidGroupMeetingClose(orgId) {
      let groupId = resource.data.get('groupId', '');
      return journeyTenantUnchanged(orgId) &&
        journeyCongregationUnchanged() &&
        request.resource.data.get('groupId', '') == groupId &&
        request.resource.data.get('startedAt', null) == resource.data.get('startedAt', null) &&
        request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') &&
        resource.data.get('status', '') == 'open' &&
        request.resource.data.get('status', '') == 'closed' &&
        request.resource.data.get('endedAt', null) == request.time &&
        request.resource.data.get('closedBy', '') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'endedAt', 'closedBy'
        ]) &&
        journeyCanManageGroupRoster(orgId, groupId);
    }

    function journeyValidGroupAttendanceCreate(orgId, attendanceId) {
      let groupId = request.resource.data.get('groupId', '');
      let meetingId = request.resource.data.get('meetingId', '');
      let personId = request.resource.data.get('personId', '');
      let congregationId = request.resource.data.get('congregationId', '');
      let meetingPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/groupMeetings/$(meetingId);
      let membershipPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/groupMemberships/$(groupId + '__' + personId);
      return request.resource.data.keys().hasOnly([
          'organizationId', 'congregationId', 'groupId', 'meetingId',
          'personId', 'status', 'recordedAt', 'recordedBy'
        ]) &&
        journeyTenantCreate(orgId) &&
        attendanceId == meetingId + '__' + personId &&
        groupId is string && groupId.size() > 0 &&
        meetingId is string && meetingId.size() > 0 &&
        personId is string && personId.size() > 0 &&
        congregationId is string && congregationId.size() > 0 &&
        request.resource.data.get('status', '') == 'present_confirmed' &&
        request.resource.data.get('recordedAt', null) == request.time &&
        request.resource.data.get('recordedBy', '') == request.auth.uid &&
        journeyCanManageGroupRoster(orgId, groupId) &&
        exists(meetingPath) &&
        get(meetingPath).data.get('groupId', '') == groupId &&
        get(meetingPath).data.get('congregationId', '') == congregationId &&
        get(meetingPath).data.get('status', '') == 'open' &&
        exists(membershipPath) &&
        get(membershipPath).data.get('groupId', '') == groupId &&
        get(membershipPath).data.get('personId', '') == personId &&
        get(membershipPath).data.get('congregationId', '') == congregationId &&
        get(membershipPath).data.get('status', '') == 'active';
    }

    function journeyValidDiscipleshipCreate() {
      return request.resource.data.get('personId', '') is string &&
        request.resource.data.get('personId', '').size() > 0 &&
        request.resource.data.get('disciplerId', '') is string &&
        request.resource.data.get('disciplerId', '').size() > 0 &&
        request.resource.data.get('meeting', 0) == 1 &&
        request.resource.data.get('status', '') == 'active';
    }

    function journeyValidDiscipleshipUpdate() {
      let meeting = request.resource.data.get('meeting', 0);
      let previousMeeting = resource.data.get('meeting', 0);
      let status = request.resource.data.get('status', '');
      return request.resource.data.get('personId', '') == resource.data.get('personId', '') &&
        meeting is number &&
        previousMeeting is number &&
        meeting >= previousMeeting &&
        meeting <= previousMeeting + 1 &&
        meeting >= 1 &&
        meeting <= 7 &&
        status in ['active', 'paused', 'completed'] &&
        (status != 'completed' || meeting == 7);
    }

    function journeyValidCanonicalFact(orgId, factId) {
      let eventType = request.resource.data.get('eventType', '');
      let payload = request.resource.data.get('payload', {});
      let personId = payload.get('personId', '');
      let sessionId = payload.get('sessionId', '');
      let checkId = payload.get('checkId', '');
      let careRequestId = payload.get('careRequestId', '');
      let personPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/people/$(personId);
      let sessionPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceSessions/$(sessionId);
      let checkPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceChecks/$(checkId);
      let carePath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/careRequests/$(careRequestId);
      return journeyTenantCreate(orgId) &&
        request.resource.data.get('eventId', '') == factId &&
        request.resource.data.get('actorId', '') == request.auth.uid &&
        request.resource.data.get('sourceApp', '') == 'nestjourney' &&
        request.resource.data.get('version', 0) == 1 &&
        request.resource.data.get('recordedAt', null) == request.time &&
        request.resource.data.get('occurredAt', null) == request.time &&
        request.resource.data.get('subjectRef', '') is string &&
        request.resource.data.get('scope', '') is string &&
        request.resource.data.get('evidenceRef', '') is string &&
        request.resource.data.get('evidenceRef', '').size() > 0 &&
        request.resource.data.get('sensitivity', '') in ['public', 'internal', 'confidential', 'restricted'] &&
        eventType in [
          'VISITOR_REGISTERED', 'PRESENCE_SESSION_OPENED', 'PRESENCE_CONFIRMED', 'PRESENCE_CORRECTED',
          'CARE_REQUESTED', 'CARE_ASSIGNED'
        ] &&
        (
          (eventType == 'VISITOR_REGISTERED' &&
            personId is string &&
            request.resource.data.get('subjectRef', '') == 'person:' + personId &&
            request.resource.data.get('evidenceRef', '') == 'person:' + personId &&
            existsAfter(personPath) &&
            request.resource.data.get('scope', '') == 'congregation:' + getAfter(personPath).data.get('congregationId', ''))
          ||
          (eventType == 'PRESENCE_SESSION_OPENED' &&
            sessionId is string &&
            request.resource.data.get('subjectRef', '') == 'presenceSession:' + sessionId &&
            request.resource.data.get('evidenceRef', '') == 'presenceSession:' + sessionId &&
            existsAfter(sessionPath) &&
            request.resource.data.get('scope', '') == 'congregation:' + getAfter(sessionPath).data.get('congregationId', ''))
          ||
          (eventType in ['PRESENCE_CONFIRMED', 'PRESENCE_CORRECTED'] &&
            checkId is string &&
            request.resource.data.get('evidenceRef', '') == 'presenceCheck:' + checkId &&
            existsAfter(checkPath) &&
            getAfter(checkPath).data.get('state', '') != 'unverified' &&
            (
              (eventType == 'PRESENCE_CONFIRMED' && getAfter(checkPath).data.get('source', '') == 'human_check')
              ||
              (eventType == 'PRESENCE_CORRECTED' && getAfter(checkPath).data.get('source', '') == 'retroactive_human_correction')
            ) &&
            request.resource.data.get('subjectRef', '') == 'person:' + getAfter(checkPath).data.get('personId', '') &&
            request.resource.data.get('scope', '') == 'congregation:' + getAfter(checkPath).data.get('congregationId', ''))
          ||
          (eventType == 'CARE_REQUESTED' &&
            careRequestId is string &&
            careRequestId.size() > 0 &&
            factId == 'care-requested-' + careRequestId &&
            existsAfter(carePath) &&
            getAfter(carePath).data.get('requestedAt', null) == request.time &&
            getAfter(carePath).data.get('requestedBy', '') == request.auth.uid &&
            getAfter(carePath).data.get('personId', '') == personId &&
            getAfter(carePath).data.get('careType', '') == payload.get('careType', '') &&
            getAfter(carePath).data.get('source', '') == payload.get('source', '') &&
            request.resource.data.get('subjectRef', '') == 'person:' + personId &&
            request.resource.data.get('evidenceRef', '') == 'careRequest:' + careRequestId &&
            request.resource.data.get('scope', '') == 'congregation:' + getAfter(carePath).data.get('congregationId', ''))
          ||
          (eventType == 'CARE_ASSIGNED' &&
            careRequestId is string &&
            careRequestId.size() > 0 &&
            factId == 'care-assigned-' + careRequestId &&
            existsAfter(carePath) &&
            getAfter(carePath).data.get('ownerRef', '') == request.auth.uid &&
            getAfter(carePath).data.get('assignedAt', null) == request.time &&
            getAfter(carePath).data.get('assignedBy', '') == request.auth.uid &&
            getAfter(carePath).data.get('personId', '') == personId &&
            getAfter(carePath).data.get('careType', '') == payload.get('careType', '') &&
            payload.get('ownerRef', '') == request.auth.uid &&
            request.resource.data.get('subjectRef', '') == 'person:' + personId &&
            request.resource.data.get('evidenceRef', '') == 'careRequest:' + careRequestId &&
            request.resource.data.get('scope', '') == 'congregation:' + getAfter(carePath).data.get('congregationId', ''))

        );
    }

    // ==========================================
    // 1. DADOS DOS USUÁRIOS    // ==========================================
    // 1. DADOS DOS USUÁRIOS
    // ==========================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isSystemAdmin() || ('organizationId' in resource.data && checkOrgAccess(resource.data.organizationId)));
      allow create: if isAuthenticated() && isSystemAdmin();
      allow update: if isAuthenticated() && (
        isSystemAdmin() ||
        (
          (isOwner(userId) || (resource != null && 'organizationId' in resource.data && isOrgAdmin(resource.data.organizationId))) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId', 'activeOrganizationId', 'primaryOrganizationId', 'defaultOrganizationId', 'lastOrganizationId', 'organizations', 'organizationIds', 'memberships', 'organizationRole', 'systemRole', 'globalRole', 'capabilities', 'appsAccess', 'products', 'lifetimeAccess'])
        )
      );
      allow delete: if isAuthenticated() && (isSystemAdmin() || (resource != null && 'organizationId' in resource.data && isOrgAdmin(resource.data.organizationId) && checkOrgAccess(resource.data.organizationId)));
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // 2. DADOS DA ORGANIZAÇÃO (CORE)
    // ==========================================

    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin() ||
        isEcosystemSupport() ||
        (resource != null && resource.data.get('ownerUid', '') == request.auth.uid) ||
        (resource != null && resource.data.get('ownerId', '') == request.auth.uid) ||
        (resource != null && resource.data.get('owner_user_id', '') == request.auth.uid) ||
        (resource != null && resource.data.get('ownerUserId', '') == request.auth.uid) ||
        checkMemberExists(orgId)
      );
      allow create: if isAuthenticated() && isSystemAdmin();
      allow update: if isAuthenticated() && (
        isSystemAdmin() ||
        resource.data.get('ownerUid', '') == request.auth.uid || 
        resource.data.get('ownerId', '') == request.auth.uid || 
        resource.data.get('owner_user_id', '') == request.auth.uid || 
        (checkMemberExists(orgId) && isOrgOwner(orgId))
      );
      allow delete: if false; 

      // ---------------------------------------------------------------------------------
      // MULTI-TENANT ISOLATION (NOVA ESTRUTURA)
      // ---------------------------------------------------------------------------------
      
      match /monthly_usage/{monthStr} {
        allow read: if isAuthenticated() && checkOrgAccess(orgId);
        allow write: if false;
      }

      match /members/{uid} {
        allow read: if isAuthenticated() && (
          uid == request.auth.uid || checkOrgReadAccess(orgId) || isSystemAdmin()
        );
        allow list: if isAuthenticated() && (checkOrgReadAccess(orgId) || isSystemAdmin());
        allow create: if isAuthenticated() && (isOrgAdmin(orgId) || isSystemAdmin());
        allow update, delete: if isAuthenticated() && (
          isOrgAdmin(orgId) || isSystemAdmin()
        );
      }

      match /invites/{inviteId} {
        // Invitation documents contain token hashes and delivery metadata.
        // All reads and mutations go through authenticated backend commands.
        allow read, create, update, delete: if false;
      }

      match /join_requests/{requestId} {
        // Sensitive membership requests stay tenant-local in Firestore.
        // Global governance reads and all mutations go through authenticated
        // backend commands so support/global identities never gain raw access.
        allow read, list: if isAuthenticated() && (
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('status', '') == 'active' &&
          (
            get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', '') == 'owner' ||
            get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', '') == 'admin' ||
            get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('organizationRole', '') == 'owner' ||
            get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('organizationRole', '') == 'admin'
          )
        );
        allow create, update, delete: if false;
      }

      match /audit_logs/{document=**} {
        allow read: if isAuthenticated() && checkOrgReadAccess(orgId);
        allow write: if isAuthenticated() && checkOrgAccess(orgId);
      }
      match /timeline/{document=**} {
        allow read: if isAuthenticated() && checkOrgReadAccess(orgId);
        allow write: if isAuthenticated() && checkOrgAccess(orgId);
      }

      // Notifications may contain personal preparation and assignment context.
      // Keep recipient isolation explicit and exclude this collection from the
      // generic organization wildcard below.
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() &&
          resource.data.get('recipientId', '') == request.auth.uid;
        allow create: if false;
        allow update: if isAuthenticated() &&
          resource.data.get('recipientId', '') == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead',
            'isArchived',
            'readAt',
            'archivedAt'
          ]);
        allow delete: if false;
      }

      // Product analytics can contain user/session attribution and error
      // context. Clients may append valid self-attributed events, but analytics
      // are not a tenant-wide data feed for ordinary members.
      match /analytics/{eventId} {
        allow create: if isAuthenticated() &&
          checkOrgAccess(orgId) &&
          isOrganizationLifecycleActive(orgId) &&
          hasValidAnalyticsEnvelope() &&
          (
            request.resource.data.eventType != 'action_os_interaction' ||
            isValidOrganizationActionOsAnalytics()
          ) &&
          request.resource.data.get('organizationId', '') == orgId &&
          request.resource.data.get('userId', '') in [
            request.auth.uid,
            'none'
          ];
        allow read: if isSystemAdmin();
        allow update, delete: if false;
      }

      // Action OS state is backend-authoritative. Clients use authenticated
      // API commands so preference ownership can never be forged.
      match /actionCenterUsers/{uid}/{document=**} {
        allow read, write: if false;
      }

      match /actionCenter/{document=**} {
        allow read, write: if false;
      }

      // NestJourney is intentionally carved out of the generic product wildcard.
      // Firestore ORs overlapping allows, so products must be excluded below.
      match /products/raiz_e_mesa {
        allow read: if journeyHasMembership(orgId);
        allow write: if false;

        match /settings/{settingsId} {
          allow read: if journeyHasMembership(orgId);
          allow create: if settingsId == 'moduleLabels' &&
            journeyCanManageSettings(orgId) &&
            journeyValidModuleLabels(orgId);
          allow update: if settingsId == 'moduleLabels' &&
            journeyCanManageSettings(orgId) &&
            resource.data.get('organizationId', '') == orgId &&
            journeyValidModuleLabels(orgId);
          allow delete: if false;
        }

        match /mesaParticipations/{recordId} {
          allow read: if journeyCanManageMesaInScope(
            orgId,
            resource.data.get('congregationId', '')
          );
          allow create: if journeyCanManageMesaInScope(
              orgId,
              request.resource.data.get('congregationId', '')
            ) &&
            journeyValidMesaParticipationCreate(orgId, recordId);
          allow update: if journeyCanManageMesaInScope(
              orgId,
              resource.data.get('congregationId', '')
            ) &&
            journeyValidMesaParticipationUpdate(orgId);
          allow delete: if false;
        }

        match /congregations/{congregationId} {
          allow read: if journeyCanAccessCongregation(orgId, congregationId);
          allow create: if journeyIsOrgAdmin(orgId) && journeyTenantCreate(orgId);
          allow update: if journeyIsOrgAdmin(orgId) && journeyTenantUnchanged(orgId);
          allow delete: if false;
        }

        match /people/{personId} {
          allow read: if journeyCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if journeyTenantCreate(orgId) &&
            request.resource.data.get('deletedAt', null) == null &&
            journeyCanAccessCongregation(orgId, request.resource.data.get('congregationId', '')) &&
            journeyCanManagePeople(orgId);
          allow update: if journeyTenantUnchanged(orgId) &&
            journeyCongregationUnchanged() &&
            journeyCanAccessCongregation(orgId, resource.data.get('congregationId', '')) &&
            journeyCanManagePeople(orgId);
          allow delete: if false;
        }

        match /presenceSessions/{sessionId} {
          allow read: if journeyCanManagePresenceInScope(
              orgId,
              resource.data.get('congregationId', '')
            ) || journeyCanManageMesaInScope(
              orgId,
              resource.data.get('congregationId', '')
            );
          allow create: if journeyCanManagePresence(orgId) &&
            journeyCanAccessCongregation(orgId, request.resource.data.get('congregationId', '')) &&
            journeyValidPresenceSessionCreate(orgId);
          allow update: if journeyCanManagePresence(orgId) &&
            resource.data.get('status', '') == 'open' &&
            journeyTenantUnchanged(orgId) &&
            journeyCongregationUnchanged() &&
            journeyCanAccessCongregation(orgId, resource.data.get('congregationId', '')) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt', 'closedBy']) &&
            request.resource.data.get('status', '') == 'closed' &&
            request.resource.data.get('closedAt', null) == request.time &&
            request.resource.data.get('closedBy', '') == request.auth.uid;
          allow delete: if false;
        }

        match /presenceChecks/{checkId} {
          allow read: if journeyCanManagePresenceInScope(orgId, resource.data.get('congregationId', ''));
          allow create: if journeyCanManagePresenceInScope(orgId, request.resource.data.get('congregationId', '')) &&
            journeyValidPresenceCheckCreate(orgId);
          allow update, delete: if false;
        }

        match /mesaPreparations/{preparationId} {
          allow read: if journeyCanManageMesaInScope(
            orgId,
            resource.data.get('congregationId', '')
          );
          allow create: if journeyValidMesaPreparationCreate(orgId, preparationId);
          allow update: if journeyValidMesaPreparationUpdate(orgId);
          allow delete: if false;
        }

        match /careRequests/{careRequestId} {
          allow read: if journeyCanManageCare(orgId) &&
            journeyCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if journeyCanCreateCareInScope(
              orgId,
              request.resource.data.get('congregationId', ''),
              request.resource.data.get('source', '')
            ) &&
            journeyValidCareRequestCreate(orgId);
          allow update: if journeyCanManageCare(orgId) &&
            journeyCanAccessCongregation(orgId, resource.data.get('congregationId', '')) &&
            (journeyValidCareClaim(orgId) || journeyValidCareResolve(orgId));
          allow delete: if false;
        }

        match /followups/{followupId} {
          allow read: if journeyCanAccessFollowup(
            orgId,
            resource.data.get('congregationId', ''),
            resource.data.get('ownerRef', '')
          );
          allow create: if journeyCanAccessFollowup(
              orgId,
              request.resource.data.get('congregationId', ''),
              request.resource.data.get('ownerRef', '')
            ) &&
            journeyValidFollowupCreate(orgId, followupId);
          allow update: if journeyCanAccessFollowup(
              orgId,
              resource.data.get('congregationId', ''),
              resource.data.get('ownerRef', '')
            ) &&
            journeyValidFollowupComplete(orgId);
          allow delete: if false;
        }

        match /facts/{factId} {
          allow read: if journeyIsOrgAdmin(orgId);
          allow create: if (
              request.resource.data.get('eventType', '') in ['FOLLOWUP_CREATED', 'FOLLOWUP_COMPLETED'] &&
              journeyValidFollowupFactDocument(orgId, factId)
            ) || (
              request.resource.data.get('eventType', '') == 'CARE_RESOLVED' &&
              journeyValidCareResolvedFactDocument(orgId, factId)
            ) || (
              request.resource.data.get('eventType', '') == 'PRESENCE_CORRECTED' &&
              journeyCanManagePresenceInScope(
                orgId,
                getAfter(
                  /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceChecks/$(request.resource.data.get('payload', {}).get('checkId', ''))
                ).data.get('congregationId', '')
              ) &&
              journeyValidCanonicalFact(orgId, factId)
            ) || (
              journeyHasMembership(orgId) &&
              (
                (request.resource.data.get('eventType', '') in ['VISITOR_REGISTERED', 'BOND_HOST_ASSIGNED'] && journeyCanManagePeople(orgId)) ||
                (request.resource.data.get('eventType', '') in ['PRESENCE_SESSION_OPENED', 'PRESENCE_CONFIRMED'] && journeyCanManagePresence(orgId)) ||
                request.resource.data.get('eventType', '') in ['CARE_REQUESTED', 'CARE_ASSIGNED']
              ) &&
              journeyValidCanonicalFact(orgId, factId)
            );
          allow update, delete: if false;
        }

        match /implementationCycles/{cycleId} {
          allow read: if journeyCanManageImplementation(orgId) &&
            journeyCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if journeyCanManageImplementation(orgId) &&
            journeyCanAccessCongregation(orgId, request.resource.data.get('congregationId', '')) &&
            journeyValidImplementationCycleCreate(orgId);
          allow update, delete: if false;

          match /steps/{stepId} {
            allow read: if journeyCanManageImplementation(orgId) &&
              journeyCanAccessCongregation(
                orgId,
                get(/databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/implementationCycles/$(cycleId)).data.get('congregationId', '')
              );
            allow create: if journeyCanManageImplementation(orgId) &&
              exists(/databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/implementationCycles/$(cycleId)) &&
              journeyCanAccessCongregation(
                orgId,
                get(/databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/implementationCycles/$(cycleId)).data.get('congregationId', '')
              ) &&
              request.resource.data.get('organizationId', '') == orgId &&
              request.resource.data.get('congregationId', '') ==
                get(/databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/implementationCycles/$(cycleId)).data.get('congregationId', '') &&
              request.resource.data.get('cycleId', '') == cycleId &&
              request.resource.data.get('playbookId', '') == 'raiz_e_mesa_2026' &&
              request.resource.data.get('key', '') == stepId &&
              journeyValidImplementationKey(stepId) &&
              request.resource.data.get('completedAt', null) == request.time &&
              request.resource.data.get('completedBy', '') == request.auth.uid;
            allow update, delete: if false;
          }
        }

        match /groups/{groupId} {
          allow read: if journeyCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if journeyTenantCreate(orgId) &&
            journeyCanAccessCongregation(orgId, request.resource.data.get('congregationId', '')) &&
            journeyCanManageGroups(orgId) &&
            journeyValidGroupState();
          allow update: if journeyTenantUnchanged(orgId) &&
            journeyCongregationUnchanged() &&
            journeyCanManageGroupRoster(orgId, groupId) &&
            journeyValidGroupState();
          allow delete: if false;
        }

        match /groupEntryRequests/{requestId} {
          allow read: if journeyCanManageGroupRoster(
            orgId,
            resource.data.get('groupId', '')
          );
          allow create: if journeyValidGroupEntryRequestCreate(orgId);
          allow update: if journeyValidGroupEntryRequestUpdate(orgId);
          allow delete: if false;
        }

        match /groupMemberships/{membershipId} {
          allow read: if journeyCanManageGroupRoster(
            orgId,
            resource.data.get('groupId', '')
          );
          allow create: if journeyValidGroupMembershipCreate(orgId, membershipId);
          allow update: if journeyValidGroupMembershipUpdate(orgId);
          allow delete: if false;
        }

        match /groupMeetings/{meetingId} {
          allow read: if journeyCanManageGroupRoster(
            orgId,
            resource.data.get('groupId', '')
          );
          allow create: if journeyValidGroupMeetingCreate(orgId);
          allow update: if journeyValidGroupMeetingClose(orgId);
          allow delete: if false;
        }

        match /groupAttendance/{attendanceId} {
          allow read: if journeyCanManageGroupRoster(
            orgId,
            resource.data.get('groupId', '')
          );
          allow create: if journeyValidGroupAttendanceCreate(orgId, attendanceId);
          allow update, delete: if false;
        }

        match /discipleships/{discipleshipId} {
          allow read: if journeyCanOperateDiscipleship(
            orgId,
            resource.data.get('congregationId', ''),
            resource.data.get('disciplerId', '')
          );
          allow create: if journeyTenantCreate(orgId)
            && journeyCanOperateDiscipleship(
              orgId,
              request.resource.data.get('congregationId', ''),
              request.resource.data.get('disciplerId', '')
            )
            && journeyValidDiscipleshipCreate();
          allow update: if journeyTenantUnchanged(orgId)
            && journeyCongregationUnchanged()
            && journeyCanOperateDiscipleship(
              orgId,
              resource.data.get('congregationId', ''),
              resource.data.get('disciplerId', '')
            )
            && request.resource.data.get('disciplerId', '') == resource.data.get('disciplerId', '')
            && journeyValidDiscipleshipUpdate();
          allow delete: if false;
        }
        match /pastoralHandoffs/{handoffId} {
          allow read: if journeyCanManagePastoral(orgId) &&
            journeyCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if journeyCanManageCare(orgId) &&
            journeyValidPastoralHandoffCreate(orgId, handoffId);
          allow update: if journeyCanManagePastoral(orgId) &&
            journeyCanAccessCongregation(orgId, resource.data.get('congregationId', '')) &&
            journeyValidPastoralHandoffResolve(orgId);
          allow delete: if false;
        }

        match /pastoral/{pastoralId} {
          allow read: if journeyHasMembership(orgId) && journeyRole(orgId) in ['owner', 'pastor'];
          allow create: if journeyTenantCreate(orgId) && journeyHasMembership(orgId) && journeyRole(orgId) in ['owner', 'pastor'];
          allow update: if journeyTenantUnchanged(orgId) && journeyHasMembership(orgId) && journeyRole(orgId) in ['owner', 'pastor'];
          allow delete: if false;
        }

        match /audit/{auditId} {
          allow read: if journeyCanViewGovernance(orgId) &&
            (
              (
                resource.data.get('congregationId', '') is string &&
                resource.data.get('congregationId', '').size() > 0 &&
                journeyCanAccessCongregation(orgId, resource.data.get('congregationId', ''))
              ) ||
              (resource.data.get('congregationId', '') == '' && journeyIsOrgAdmin(orgId))
            );
          allow create: if journeyHasMembership(orgId) &&
            journeyTenantCreate(orgId) &&
            request.resource.data.get('actorId', '') == request.auth.uid &&
            request.resource.data.get('action', '') is string &&
            request.resource.data.get('createdAt', null) == request.time &&
            (
              (
                request.resource.data.get('congregationId', '') is string &&
                request.resource.data.get('congregationId', '').size() > 0 &&
                journeyCanAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
              ) ||
              (request.resource.data.get('congregationId', '') == '' && journeyIsOrgAdmin(orgId))
            );
          allow update, delete: if false;
        }

        match /retentionRequests/{requestId} {
          allow read: if journeyCanManagePrivacy(orgId) &&
            journeyCanAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if journeyCanManagePrivacy(orgId) &&
            journeyCanAccessCongregation(orgId, request.resource.data.get('congregationId', '')) &&
            journeyValidPrivacyRequestCreate(orgId);
          allow update, delete: if false;
        }

        match /{document=**} {
          allow read, write: if false;
        }
      }

      // Preserve the previous generic behavior for other product namespaces.
      match /products/{productId}/{document=**} {
        allow read: if productId != 'raiz_e_mesa' &&
          isAuthenticated() && checkOrgReadAccess(orgId) && isOrgActive(orgId);
        allow create, update, delete: if productId != 'raiz_e_mesa' &&
          isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
      }

      match /{app}/{document=**} {
        // Firestore ORs overlapping allow rules. Sensitive subcollections with
        // narrower policies must never inherit this generic tenant-wide access.
        allow read: if app != 'products' && app != 'join_requests' && app != 'actionCenterUsers' && app != 'actionCenter' && app != 'notifications' && app != 'analytics' && isAuthenticated() && checkOrgReadAccess(orgId) && isOrgActive(orgId);
        allow create: if app != 'products' && app != 'join_requests' && app != 'actionCenterUsers' && app != 'actionCenter' && app != 'notifications' && app != 'analytics' && isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
        allow update, delete: if app != 'products' && app != 'join_requests' && app != 'actionCenterUsers' && app != 'actionCenter' && app != 'notifications' && app != 'analytics' && isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
      }
    }

    match /organization_members/{id} {
      allow read: if isAuthenticated() && (
        id.split('_')[0] == request.auth.uid ||
        id.split('_')[1] == request.auth.uid ||
        checkOrgAccess(id.split('_')[1]) ||
        checkOrgAccess(id.split('_')[0])
      );
      allow list: if isAuthenticated() && isSystemAdmin();
      allow create: if isAuthenticated() && (isOrgAdmin(request.resource.data.get('organizationId', '')) || isSystemAdmin());
      allow update: if isAuthenticated() && (
        isSystemAdmin() || 
        (checkOrgAccess(resource.data.get('organizationId', '')) && isOrgAdmin(resource.data.get('organizationId', '')))
      );
      allow delete: if isAuthenticated() && (
        isSystemAdmin() || 
        (checkOrgAccess(resource.data.get('organizationId', '')) && isOrgAdmin(resource.data.get('organizationId', '')))
      );
    }

    // ==========================================
    // 3. ASSINATURAS E CONVITES
    // ==========================================
    
    match /subscriptions/{userId} {
      allow read, list: if isAuthenticated() && (
        checkOrgReadAccess(userId) || 
        isSystemAdmin() ||
        (resource != null && 'organizationId' in resource.data && checkOrgReadAccess(resource.data.organizationId)) ||
        (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
        (resource == null)
      );
      allow write: if false; 
    }

    match /stripe_events_audit/{eventId} {
      allow read, write: if false;
    }

    match /invitations/{inviteId} {
      allow read: if isAuthenticated() && ('organizationId' in resource.data && checkOrgAccess(resource.data.organizationId));
       allow write: if isAuthenticated() && 
                    checkMemberExists(request.resource.data.get('organizationId', '')) &&
                    isOrgAdmin(request.resource.data.get('organizationId', '')) &&
                    isOrgActive(request.resource.data.get('organizationId', ''));
    }
    
    match /invites/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organization_id', ''));
      allow write: if false; 
    }

    // ==========================================
    // 4. MÓDULOS DE NEGÓCIO (APP MILLIONSNEST E OUTROS)
    // ==========================================
    
    match /repertoire/{songId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && checkOrgAccess(request.resource.data.get('organizationId', '')) && isOrgActive(request.resource.data.get('organizationId', ''));
      allow update: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /schedules/{scheduleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && checkOrgAccess(request.resource.data.get('organizationId', '')) && isOrgActive(request.resource.data.get('organizationId', ''));
      allow update: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /feedbacks/{feedbackId} {
       allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
       allow create: if isAuthenticated() && (request.resource.data.get('organizationId', '') == 'none' || (checkOrgAccess(request.resource.data.get('organizationId', '')) && isOrgActive(request.resource.data.get('organizationId', ''))));
       allow update, delete: if false;
    }

    // ==========================================
    // 5. MÓDULOS MUSIC SCALE (ACERVO MUSIC SCALE)
    // ==========================================

    match /songs/{songId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /scales/{scaleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageScales') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    // Keep response privacy compatible with MusicScale's canonical policy:
    // a person may read only their own response; team summaries require the
    // canonical MusicScale managed-response capability / leadership role.
    match /scales/{scaleId}/responses/{responseId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/scales/$(scaleId)) &&
          canReadManagedScaleResponses(
            get(/databases/$(database)/documents/scales/$(scaleId)).data.get('organizationId', '')
          )
        )
      );
      allow create, update, delete: if false;
    }

    match /scales/{scaleId}/responseHistory/{historyId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin() ||
        (
          exists(/databases/$(database)/documents/scales/$(scaleId)) &&
          canReadManagedScaleResponses(
            get(/databases/$(database)/documents/scales/$(scaleId)).data.get('organizationId', '')
          )
        )
      );
      allow create, update, delete: if false;
    }

    match /bandScales/{scaleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageScales') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /fixedBandScales/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageScales') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /liveSessions/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageScales') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', '')) && (!('organizationId' in request.resource.data) || request.resource.data.get('organizationId', '') == resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageScales') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /roles/{roleId} {
      allow get: if isAuthenticated() && 'organizationId' in resource.data && checkOrgAccess(resource.data.get('organizationId', ''));
      allow list: if isAuthenticated() && 'organizationId' in resource.data && (checkOrgAccess(resource.data.get('organizationId', '')) || checkMemberExists(resource.data.get('organizationId', '')) || resource.data.get('organizationId', '') == request.auth.uid);
      allow create: if isAuthenticated() && isOrgAdmin(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && isOrgAdmin(resource.data.get('organizationId', '')) && checkOrgAccess(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && isOrgAdmin(resource.data.get('organizationId', '')) && checkOrgAccess(resource.data.get('organizationId', ''));
    }

    match /locations/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /eventTypes/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /eventNames/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /tags/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /instruments/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasPermission(incoming().get('organizationId', ''), 'canManageRepertoire') && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    match /suggestions/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow create: if isAuthenticated() && hasOrgContext(incoming()) && isOrgActive(incoming().get('organizationId', ''));
      allow update: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
      allow delete: if isAuthenticated() && hasPermission(resource.data.get('organizationId', ''), 'canManageRepertoire') && checkOrgAccess(resource.data.get('organizationId', '')) && isOrgActive(resource.data.get('organizationId', ''));
    }

    // ==========================================
    // 6. RECURSOS GLOBAIS
    // ==========================================

    function hasGlobalLibraryFeature() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let orgId = userDoc != null ? userDoc.data.get('organizationId', null) : null;
      let subDoc = orgId != null ? get(/databases/$(database)/documents/subscriptions/$(orgId)) : null;
      return subDoc != null && subDoc.data.get('features', {}).get('globalLibrary', false) == true;
    }

    match /globalSongs/{id} {
      allow read: if isAuthenticated() && (isSystemAdmin() || hasGlobalLibraryFeature());
      allow write: if isAuthenticated() && isSystemAdmin();
    }

    match /songSubmissions/{id} {
      allow read: if isAuthenticated() && (isSystemAdmin() || resource.data.get('submittedBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && hasOrgContext(incoming());
      allow update, delete: if isSystemAdmin();
    }
    
    // ==========================================
    // 7. ECOSYSTEM INFRASTRUCTURE COLLECTIONS
    // ==========================================

    function hasValidAnalyticsEnvelope() {
      return request.resource.data.keys().hasOnly([
        'eventType',
        'organizationId',
        'userId',
        'sessionId',
        'app',
        'metadata',
        'timestamp'
      ]) &&
      request.resource.data.keys().hasAll([
        'eventType',
        'organizationId',
        'userId',
        'sessionId',
        'app',
        'metadata',
        'timestamp'
      ]) &&
      request.resource.data.eventType is string &&
      request.resource.data.eventType.size() > 0 &&
      request.resource.data.eventType.size() <= 64 &&
      request.resource.data.organizationId is string &&
      request.resource.data.organizationId.size() <= 128 &&
      request.resource.data.userId is string &&
      request.resource.data.userId.size() <= 128 &&
      request.resource.data.sessionId is string &&
      request.resource.data.sessionId.size() > 0 &&
      request.resource.data.sessionId.size() <= 128 &&
      request.resource.data.app is string &&
      request.resource.data.app.size() > 0 &&
      request.resource.data.app.size() <= 64 &&
      request.resource.data.metadata is map &&
      request.resource.data.timestamp is timestamp;
    }

    function isValidOrganizationActionOsAnalytics() {
      let data = request.resource.data;
      let metadata = data.metadata;

      return data.eventType == 'action_os_interaction' &&
        data.app == 'millionsnest_core' &&
        metadata.keys().hasAll([
          'action',
          'lane',
          'sourceApp'
        ]) &&
        metadata.keys().hasOnly([
          'action',
          'lane',
          'sourceApp',
          'signalType',
          'priority',
          'dismissCode'
        ]) &&
        metadata.action in [
          'action_opened',
          'action_snoozed',
          'action_dismissed',
          'change_reviewed',
          'commitment_opened'
        ] &&
        metadata.lane in [
          'action',
          'change',
          'commitment'
        ] &&
        metadata.sourceApp in [
          'hub',
          'musicscale'
        ] &&
        (
          !('signalType' in metadata) ||
          (
            metadata.get('signalType', '') is string &&
            metadata.get('signalType', '').size() > 0 &&
            metadata.get('signalType', '').size() <= 80
          )
        ) &&
        (
          !('priority' in metadata) ||
          metadata.get('priority', '') in [
            'low',
            'normal',
            'high',
            'urgent'
          ]
        ) &&
        (
          !('dismissCode' in metadata) ||
          (
            metadata.get('action', '') == 'action_dismissed' &&
            metadata.get('dismissCode', '') in [
              'not_relevant',
              'already_handled',
              'not_my_responsibility',
              'too_early',
              'no_reason'
            ]
          )
        );
    }

    function isValidPublicMusicScaleAnalytics() {
      let data = request.resource.data;
      let isPublicIdentity =
        data.organizationId == 'none' &&
        data.userId == 'none' &&
        data.app == 'musicscale';

      let isLandingView =
        data.eventType == 'page_view' &&
        data.metadata.keys().hasOnly(['page']) &&
        data.metadata.get('page', '') == 'sales_landing';

      let isTrialPlanChoice =
        data.eventType == 'trial_cta_clicked' &&
        data.metadata.keys().hasOnly(['action', 'source']) &&
        data.metadata.get('action', '') == 'choose_plan' &&
        data.metadata.get('source', '') == 'sales_landing_primary';

      let isDemoOpened =
        data.eventType == 'app_usage' &&
        data.metadata.keys().hasOnly(['action', 'source']) &&
        data.metadata.get('action', '') == 'sales_demo_opened' &&
        data.metadata.get('source', '') == 'sales_landing';

      let isDemoStep =
        data.eventType == 'app_usage' &&
        data.metadata.keys().hasOnly(['action', 'step']) &&
        data.metadata.get('action', '') == 'sales_demo_step_selected' &&
        data.metadata.get('step', 0) is int &&
        data.metadata.get('step', 0) >= 1 &&
        data.metadata.get('step', 0) <= 5;

      return isPublicIdentity && (
        isLandingView ||
        isTrialPlanChoice ||
        isDemoOpened ||
        isDemoStep
      );
    }

    function isValidAuthenticatedAnalytics() {
      return isAuthenticated() && (
        request.resource.data.userId == 'none' ||
        request.resource.data.userId == request.auth.uid
      );
    }

    match /analytics_events/{eventId} {
      allow create: if hasValidAnalyticsEnvelope() && (
        isValidAuthenticatedAnalytics() ||
        isValidPublicMusicScaleAnalytics()
      );
      allow read: if isSystemAdmin();
      allow update, delete: if false;
    }

    match /system_audit_logs/{logId} {
      allow create: if isAuthenticated(); 
      allow read: if isSystemAdmin();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow create: if isAuthenticated(); 
      allow read: if isSystemAdmin();
      allow update, delete: if isSystemAdmin(); 
    }

    match /audits/{logId} {
      allow create: if isAuthenticated(); 
      allow read: if isSystemAdmin();
      allow update, delete: if isSystemAdmin(); 
    }

    match /apps/{appId} {
      allow read: if isAuthenticated(); 
      allow write: if isSystemAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }

    match /ecosystemHandoffs/{handoffId} {
      allow read, write: if false;
    }
  }
}
