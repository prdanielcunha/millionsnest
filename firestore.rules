rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    // ==========================================
    // FUNÇÕES AUXILIARES E GLOBAIS
    // ==========================================

    function isAuthenticated() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function checkMemberExists(orgId) {
      return (orgId is string) && (
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId)) ||
        exists(/databases/$(database)/documents/organization_members/$(orgId + '_' + request.auth.uid))
      );
    }

    function isOrgActive(orgId) {
      let orgDoc = get(/databases/$(database)/documents/organizations/$(orgId));
      let orgData = orgDoc != null ? orgDoc.data : null;
      let orgActive = orgData != null && (
        orgData.subscription_status == 'active' ||
        orgData.subscription_status == 'trialing' ||
        orgData.subscriptionStatus == 'active' ||
        orgData.subscriptionStatus == 'trialing' ||
        orgData.status == 'active' ||
        orgData.status == 'trialing'
      );
      
      let subDoc = get(/databases/$(database)/documents/subscriptions/$(orgId));
      let subActive = subDoc != null && subDoc.data != null && (subDoc.data.status == 'active' || subDoc.data.status == 'trialing');
      
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let userData = userDoc != null ? userDoc.data : null;
      let userActive = userData != null && (
        userData.status == 'active' || userData.status == 'trialing' ||
        userData.subscription_status == 'active' || userData.subscription_status == 'trialing' ||
        userData.subscriptionStatus == 'active' || userData.subscriptionStatus == 'trialing'
      );

      return orgActive || subActive || userActive;
    }

    function checkOrgAccess(orgId) {
      let orgDoc = get(/databases/$(database)/documents/organizations/$(orgId));
      let orgData = orgDoc != null ? orgDoc.data : null;
      let isOwner = orgData != null && (
        orgData.ownerUid == request.auth.uid || 
        orgData.ownerId == request.auth.uid || 
        orgData.owner_user_id == request.auth.uid ||
        orgData.ownerUserId == request.auth.uid
      );
      
      return (checkMemberExists(orgId) || orgId == request.auth.uid || isOwner);
    }

    function hasOrgContext(data) {
      return ('organizationId' in data) && checkOrgAccess(data.organizationId);
    }
    
    function getMemberRole(orgId) {
       return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
         ? get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role
         : (exists(/databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId))
            ? get(/databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId)).data.role
            : (exists(/databases/$(database)/documents/organization_members/$(orgId + '_' + request.auth.uid))
               ? get(/databases/$(database)/documents/organization_members/$(orgId + '_' + request.auth.uid)).data.role
               : null));
    }

    function isOrgAdmin(orgId) {
      let role = getMemberRole(orgId);
      return role == 'admin' || role == 'owner' || orgId == request.auth.uid;
    }

    function isOrgOwner(orgId) {
      let role = getMemberRole(orgId);
      return role == 'owner' || orgId == request.auth.uid;
    }

    function getMemberPermissions(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
         ? get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data
         : (exists(/databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId))
            ? get(/databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId)).data
            : (exists(/databases/$(database)/documents/organization_members/$(orgId + '_' + request.auth.uid))
               ? get(/databases/$(database)/documents/organization_members/$(orgId + '_' + request.auth.uid)).data
               : null));
    }

    function hasPermission(orgId, permission) {
      let memberData = getMemberPermissions(orgId);
      let role = memberData != null ? memberData.role : null;
      let hasExplicitPerm = memberData != null && 'permissions' in memberData && permission in memberData.permissions && memberData.permissions[permission] == true;
      
      // Endurecimento progressivo: liberado para admin/owner/systemAdmin, ou se tiver a permissão explicitamente.
      // E fallback tolerante para 'member' para não quebrar a produção abruptamente.
      return isSystemAdmin() || role == 'owner' || role == 'admin' || hasExplicitPerm || role == 'member';
    }
    
    function isSystemAdmin() {
      return request.auth != null && 'email' in request.auth.token && (request.auth.token.email.toLowerCase() == 'pastordanielpcunha@gmail.com' || request.auth.token.email.toLowerCase() == 'danielcunhapastor@gmail.com');
    }

    // ==========================================
    // 1. DADOS DOS USUÁRIOS
    // ==========================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || ('organizationId' in resource.data && checkOrgAccess(resource.data.organizationId)));
      allow create: if isAuthenticated() && userId == request.auth.uid;
      allow update: if isAuthenticated() && (isOwner(userId) || (resource != null && 'organizationId' in resource.data && isOrgAdmin(resource.data.organizationId)));
      allow delete: if isAuthenticated() && resource != null && 'organizationId' in resource.data && isOrgAdmin(resource.data.organizationId) && checkOrgAccess(resource.data.organizationId);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // 2. DADOS DA ORGANIZAÇÃO (CORE)
    // ==========================================

    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.ownerUid == request.auth.uid) ||
        (resource != null && resource.data.ownerId == request.auth.uid) ||
        (resource != null && resource.data.owner_user_id == request.auth.uid) ||
        checkMemberExists(orgId) ||
        orgId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isSystemAdmin() ||
        resource.data.ownerUid == request.auth.uid || 
        resource.data.ownerId == request.auth.uid || 
        resource.data.owner_user_id == request.auth.uid || 
        orgId == request.auth.uid ||
        (checkMemberExists(orgId) && isOrgOwner(orgId))
      );
      allow delete: if false; 

      // ---------------------------------------------------------------------------------
      // MULTI-TENANT ISOLATION (NOVA ESTRUTURA)
      // ---------------------------------------------------------------------------------
      
      match /members/{uid} {
        allow read: if isAuthenticated() && (
          uid == request.auth.uid || checkOrgAccess(orgId) || isSystemAdmin()
        );
        allow list: if isAuthenticated() && (checkOrgAccess(orgId) || isSystemAdmin());
        allow create: if isAuthenticated() && (
          uid == request.auth.uid || isOrgAdmin(orgId) || isSystemAdmin()
        );
        allow update, delete: if isAuthenticated() && (
          isOrgAdmin(orgId) || isSystemAdmin()
        );
      }

      // Generic match for all apps inside the organization (e.g. /organizations/{orgId}/musicscale/songs/{songId})
      match /{app}/{document=**} {
        allow read: if isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
        allow create: if isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
        // Progressivo: permitir updates genéricos para quem tem acesso em fase de fallback
        allow update, delete: if isAuthenticated() && checkOrgAccess(orgId) && isOrgActive(orgId);
      }
    }

    match /organization_members/{id} {
      allow read: if isAuthenticated() && (
        id.split('_')[0] == request.auth.uid ||
        id.split('_')[1] == request.auth.uid ||
        checkOrgAccess(id.split('_')[1]) ||
        checkOrgAccess(id.split('_')[0])
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.uid == request.auth.uid || 
        request.resource.data.user_id == request.auth.uid || 
        isOrgAdmin(request.resource.data.organizationId)
      );
      allow update: if isAuthenticated() && (
        isSystemAdmin() || 
        (checkOrgAccess(resource.data.organizationId) && isOrgAdmin(resource.data.organizationId))
      );
      allow delete: if isAuthenticated() && (
        isSystemAdmin() || 
        (checkOrgAccess(resource.data.organizationId) && isOrgAdmin(resource.data.organizationId))
      );
    }

    // ==========================================
    // 3. ASSINATURAS E CONVITES
    // ==========================================
    
    match /subscriptions/{userId} {
      allow read, list: if isAuthenticated() && (
        checkOrgAccess(userId) || 
        (resource != null && 'organizationId' in resource.data && checkOrgAccess(resource.data.organizationId)) ||
        (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
        (resource == null)
      );
      allow write: if false; 
    }

    match /stripe_events_audit/{eventId} {
      allow read, write: if false;
    }

    match /invitations/{inviteId} {
       allow read: if isAuthenticated();
       allow write: if isAuthenticated() && 
                    checkMemberExists(request.resource.data.organizationId) &&
                    isOrgAdmin(request.resource.data.organizationId) &&
                    isOrgActive(request.resource.data.organizationId);
    }
    
    match /invites/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organization_id);
      allow write: if false; 
    }

    // ==========================================
    // 4. MÓDULOS DE NEGÓCIO (APP MILLIONSNEST E OUTROS)
    // ==========================================
    
    match /repertoire/{songId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && checkOrgAccess(request.resource.data.organizationId) && isOrgActive(request.resource.data.organizationId);
      allow update, delete: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /schedules/{scheduleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && checkOrgAccess(request.resource.data.organizationId) && isOrgActive(request.resource.data.organizationId);
      allow update, delete: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /feedbacks/{feedbackId} {
       allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
       allow create: if isAuthenticated() && checkOrgAccess(request.resource.data.organizationId) && isOrgActive(request.resource.data.organizationId);
       allow update, delete: if false;
    }

    // ==========================================
    // 5. MÓDULOS MUSIC SCALE (ACERVO MUSIC SCALE)
    // ==========================================

    match /songs/{songId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && hasPermission(incoming().organizationId, 'canManageRepertoire') && isOrgActive(incoming().organizationId);
      allow update: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow delete: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /scales/{scaleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && hasPermission(incoming().organizationId, 'canManageScales') && isOrgActive(incoming().organizationId);
      allow update: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageScales') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow delete: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageScales') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /bandScales/{scaleId} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && hasPermission(incoming().organizationId, 'canManageScales') && isOrgActive(incoming().organizationId);
      allow update: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageScales') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow delete: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageScales') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /fixedBandScales/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && hasPermission(incoming().organizationId, 'canManageScales') && isOrgActive(incoming().organizationId);
      allow update: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageScales') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow delete: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageScales') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /roles/{roleId} {
      allow get: if isAuthenticated() && 'organizationId' in resource.data && checkOrgAccess(resource.data.organizationId);
      allow list: if isAuthenticated() && 'organizationId' in resource.data && (checkOrgAccess(resource.data.organizationId) || checkMemberExists(resource.data.organizationId) || resource.data.organizationId == request.auth.uid);
      allow create: if isAuthenticated() && isOrgAdmin(incoming().organizationId);
      allow update: if isAuthenticated() && isOrgAdmin(resource.data.organizationId) && checkOrgAccess(resource.data.organizationId);
      allow delete: if isAuthenticated() && isOrgAdmin(resource.data.organizationId) && checkOrgAccess(resource.data.organizationId);
    }

    match /locations/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && hasPermission(incoming().organizationId, 'canManageRepertoire') && isOrgActive(incoming().organizationId);
      allow update: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow delete: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /eventTypes/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && hasPermission(incoming().organizationId, 'canManageRepertoire') && isOrgActive(incoming().organizationId);
      allow update: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow delete: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /eventNames/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && hasPermission(incoming().organizationId, 'canManageRepertoire') && isOrgActive(incoming().organizationId);
      allow update: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow delete: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /tags/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && hasPermission(incoming().organizationId, 'canManageRepertoire') && isOrgActive(incoming().organizationId);
      allow update: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow delete: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /instruments/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && hasPermission(incoming().organizationId, 'canManageRepertoire') && isOrgActive(incoming().organizationId);
      allow update: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow delete: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    match /suggestions/{id} {
      allow read: if isAuthenticated() && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow create: if isAuthenticated() && hasOrgContext(incoming()) && isOrgActive(incoming().organizationId);
      allow update: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
      allow delete: if isAuthenticated() && hasPermission(resource.data.organizationId, 'canManageRepertoire') && checkOrgAccess(resource.data.organizationId) && isOrgActive(resource.data.organizationId);
    }

    // ==========================================
    // 6. RECURSOS GLOBAIS
    // ==========================================

    function hasGlobalLibraryFeature() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let orgId = userDoc != null ? userDoc.data.organizationId : null;
      let subDoc = get(/databases/$(database)/documents/subscriptions/$(orgId));
      return subDoc != null && subDoc.data.features != null && subDoc.data.features.globalLibrary == true;
    }

    match /globalSongs/{id} {
      allow read: if isAuthenticated() && (isSystemAdmin() || hasGlobalLibraryFeature());
      allow write: if isSystemAdmin();
    }

    match /songSubmissions/{id} {
      allow read: if isAuthenticated() && (isSystemAdmin() || resource.data.submittedBy == request.auth.uid);
      allow create: if isAuthenticated() && hasOrgContext(incoming());
      allow update, delete: if isSystemAdmin();
    }
    // ==========================================
    // 7. ECOSYSTEM INFRASTRUCTURE COLLECTIONS
    // ==========================================

    match /analytics_events/{eventId} {
      allow create: if true;
      allow read: if isSystemAdmin();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      // Audit logs are write-only for clients (or read for admins)
      allow create: if isAuthenticated(); 
      allow read: if isSystemAdmin();
      allow update, delete: if false; // Immutable
    }

    match /apps/{appId} {
      allow read: if isAuthenticated(); // Anyone in the system can read available apps
      allow write: if isSystemAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }
  }
}

